<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise ParaBank Test Suite" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="Core and Advanced Banking Test Suite">
        <classes>
            <!-- Prompt 1 Core Framework Tests -->
            <class name="tests.LoginTest"/>
            <class name="tests.RegistrationTest"/>
            <class name="tests.AccountOverviewTest"/>

            <!-- Prompt 2 Advanced Banking Tests -->
            <class name="tests.TransferFundsTest"/>
            <class name="tests.BillPayTest"/>
            <class name="tests.OpenNewAccountTest"/>
            <class name="tests.FindTransactionsTest"/>
        </classes>
    </test>
</suite>
